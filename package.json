{
  "name": "logger-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs && node tests/browser-extended.mjs",
    "test:fit": "node tests/fit-service.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "build:fit": "node server/build.mjs",
    "serve": "node --env-file-if-exists=.env.local server/index.mjs",
    "format": "prettier --write src tests/*.ts server/*.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.0",
    "@garmin/fitsdk": "21.214.0",
    "@supabase/supabase-js": "^2.0.0",
    "idb": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.9",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
